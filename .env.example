# ---- Server-side (Vercel: Settings > Environment Variables). NEVER prefix with VITE_ ----
GEMINI_API_KEY="your-gemini-api-key"

# ---- Browser-side (public by design; Vercel needs these at BUILD time) ----
# The SAME Supabase project the OpticPortal sales-agent app and the inventory app use
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Shop links open as https://{slug}.BASE_DOMAIN  (or ?shop={slug} for testing)
VITE_BASE_DOMAIN="envisioneyewear.store"

# Optional, development only
# VITE_DEFAULT_SHOP_SLUG="your-test-shop-slug"
# VITE_ENABLE_DEMO="true"      # enables the sample showroom (leave OFF on the live site)
